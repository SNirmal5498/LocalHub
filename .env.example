# LocalHub Environment Variables Configuration

# Server Port
PORT=3000

# JSON Web Token Secret Key
JWT_SECRET="your_jwt_secret_here"

# MongoDB Database Connection URI (MongoDB Atlas or self-hosted)
MONGO_URI="mongodb://localhost:27017/localhub"

# Initial SuperAdmin Credentials (created on launch if no admin exists)
ADMIN_EMAIL="admin@localhub.com"
ADMIN_PASSWORD="your_secure_admin_password"

# Optional: Cloudinary Credentials for CDN Image Storage (if omitted, images use direct asset URLs)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

